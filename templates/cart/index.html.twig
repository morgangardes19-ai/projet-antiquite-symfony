{% extends 'base.html.twig' %}

{% block title %}Mon panier — Atelier d'Antan{% endblock %}

{% block body %}
    <section class="max-w-5xl mx-auto px-4 py-12">

        <h1 class="font-serif text-4xl text-stone-900 mb-8">Mon panier</h1>

        {% if lines is empty %}

            {# PANIER VIDE #}
            <div class="bg-white rounded-xl border border-stone-200 p-12 text-center">
                <p class="text-4xl mb-4" aria-hidden="true">🛒</p>
                <p class="text-stone-600 mb-6">Votre panier est vide.</p>
                <a
                    href="{{ path('app_catalog_index') }}"
                    class="inline-block px-6 py-3 rounded-lg bg-amber-700 text-white
                      font-semibold hover:bg-amber-800 transition"
                >
                    Découvrir le catalogue
                </a>
            </div>

        {% else %}

            {# PANIER REMPLI #}
            <div class="flex flex-col gap-2">

                {# ---------- EN-TÊTE DE COLONNES — desktop uniquement ---------- #}
                <div
                    class="hidden md:flex md:items-center md:gap-4 px-4 py-2
                            text-xs uppercase tracking-wider text-stone-500"
                >
                    <span class="grow basis-0">Pièce</span>
                    <span class="w-28 text-right">Prix unitaire</span>
                    <span class="w-44">Quantité</span>
                    <span class="w-28 text-right">Sous-total</span>
                    <span class="w-6"><span class="sr-only">Actions</span></span>
                </div>

                {# ---------- CARTES ---------- #}
                <ul class="flex flex-col gap-4">
                    {% for line in lines %}
                        <li
                            class="flex flex-col gap-3 p-4
                                   bg-white rounded-xl border border-stone-200
                                   md:flex-row md:items-center md:gap-4 md:px-4 md:py-4"
                        >

                            {# ---------- PIÈCE — titre de la carte ---------- #}
                            <div
                                class="border-b border-stone-100 pb-2
                                        md:border-0 md:pb-0 md:grow md:basis-0"
                            >
                                <a
                                    href="{{ path('app_catalog_show', {'slug': line.product.slug}) }}"
                                    class="font-medium text-stone-900 hover:text-amber-700 transition"
                                >
                                    {{ line.product.name }}
                                </a>
                            </div>

                            {# ---------- PRIX UNITAIRE ---------- #}
                            <div
                                class="flex items-center justify-between gap-3
                                        md:w-28 md:justify-end"
                            >
                                <span
                                    class="text-xs font-medium uppercase tracking-wide
                                             text-stone-500 md:hidden"
                                >
                                    Prix unitaire
                                </span>
                                <span class="text-sm text-stone-900">
                                    {{ line.product.price|number_format(2, ',', ' ') }} €
                                </span>
                            </div>

                            {# ---------- QUANTITÉ ---------- #}
                            <div class="flex items-center justify-between gap-3 md:w-44">
                                <span
                                    class="text-xs font-medium uppercase tracking-wide
                                             text-stone-500 md:hidden"
                                >
                                    Quantité
                                </span>

                                <form
                                    method="post"
                                    action="{{ path('app_cart_update', {'id': line.product.id}) }}"
                                    class="flex items-center gap-1.5 md:gap-2"
                                >
                                    <label for="qty-{{ line.product.id }}" class="sr-only">
                                        Quantité pour {{ line.product.name }}
                                    </label>

                                    <input
                                        type="number"
                                        id="qty-{{ line.product.id }}"
                                        name="quantity"
                                        value="{{ line.quantity }}"
                                        min="1"
                                        max="{{ line.product.stock }}"
                                        class="w-16 md:w-20 rounded-lg border-stone-300 text-center text-sm
                                          focus:border-amber-500 focus:ring-amber-500"
                                    >

                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('cart_update_' ~ line.product.id) }}"
                                    >

                                    <button
                                        type="submit"
                                        class="text-xs font-medium text-amber-700 hover:underline"
                                    >
                                        Modifier
                                    </button>
                                </form>
                            </div>

                            {# ---------- SOUS-TOTAL ---------- #}
                            <div
                                class="flex items-center justify-between gap-3
                                        md:w-28 md:justify-end"
                            >
                                <span
                                    class="text-xs font-medium uppercase tracking-wide
                                             text-stone-500 md:hidden"
                                >
                                    Sous-total
                                </span>
                                <span class="text-sm font-semibold text-stone-900">
                                    {{ line.subtotal|number_format(2, ',', ' ') }} €
                                </span>
                            </div>

                            {# ---------- SUPPRIMER ---------- #}
                            <div
                                class="flex items-center justify-end gap-3
                                        border-t border-stone-100 pt-2
                                        md:border-0 md:pt-0 md:w-6"
                            >
                                <form
                                    method="post"
                                    action="{{ path('app_cart_remove', {'id': line.product.id}) }}"
                                >
                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('cart_remove_' ~ line.product.id) }}"
                                    >

                                    <button
                                        type="submit"
                                        class="inline-flex items-center gap-2 text-sm text-stone-500
                                               hover:text-red-600 transition rounded
                                               focus:outline-none focus:ring-2 focus:ring-red-500"
                                        aria-label="Retirer {{ line.product.name }} du panier"
                                    >
                                        <span aria-hidden="true">🗑️</span>
                                        <span class="md:hidden">Retirer</span>
                                    </button>
                                </form>
                            </div>

                        </li>
                    {% endfor %}
                </ul>

                {# ---------- TOTAL ---------- #}
                <div
                    class="flex items-center justify-between gap-4
                            bg-stone-50 rounded-xl border border-stone-200 px-4 py-4"
                >
                    <span class="font-semibold text-stone-700">Total</span>
                    <span class="text-xl font-bold text-amber-800">
                        {{ total|number_format(2, ',', ' ') }} €
                    </span>
                </div>

            </div>

            <div class="pt-6 flex justify-between items-center">
                <a
                    href="{{ path('app_catalog_index') }}"
                    class="text-sm text-stone-600 hover:text-amber-700 transition"
                >
                    ← Continuer mes achats
                </a>
            </div>

        {% endif %}

    </section>
{% endblock %}
