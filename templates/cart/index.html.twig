{% extends 'base.html.twig' %}

{% block title %}Mon panier — Atelier d'Antan{% endblock %}

{% block body %}
    <section class="max-w-5xl mx-auto px-4 py-12">

        <h1 class="font-serif text-4xl text-stone-900 mb-8">Mon panier</h1>

        {% if lines is empty %}

            {# ══════════ PANIER VIDE ══════════ #}
            <div class="bg-white rounded-xl border border-stone-200 p-12 text-center">
                <p class="text-4xl mb-4" aria-hidden="true">🛒</p>
                <p class="text-stone-600 mb-6">Votre panier est vide.</p>
                <a
                    href="{{ path('app_catalog_index') }}"
                    class="inline-block px-6 py-3 rounded-lg bg-amber-700 text-white
                      font-semibold hover:bg-amber-800 transition"
                >
                    Découvrir le catalogue
                </a>
            </div>

        {% else %}

            {# ══════════ PANIER REMPLI ══════════ #}
            <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
                <table class="w-full text-sm">
                    <thead class="bg-stone-100 text-left text-stone-600">
                        <tr>
                            <th scope="col" class="px-4 py-3 font-medium">Pièce</th>
                            <th scope="col" class="px-4 py-3 font-medium">Prix unitaire</th>
                            <th scope="col" class="px-4 py-3 font-medium">Quantité</th>
                            <th scope="col" class="px-4 py-3 font-medium text-right">Sous-total</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for line in lines %}
                            <tr class="border-t border-stone-200">
                                <td class="px-4 py-4">
                                    <a
                                        href="{{ path('app_catalog_show', {'slug': line.product.slug}) }}"
                                        class="font-medium text-stone-900 hover:text-amber-700 transition"
                                    >
                                        {{ line.product.name }}
                                    </a>
                                </td>
                                <td class="px-4 py-4 text-stone-600">
                                    {{ line.product.price|number_format(2, ',', ' ') }} €
                                </td>
                                <td class="px-4 py-4">
                                    {{ line.quantity }}
                                </td>
                                <td class="px-4 py-4 text-right font-semibold">
                                    {{ line.subtotal|number_format(2, ',', ' ') }} €
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>

                    <tfoot>
                        <tr class="border-t-2 border-stone-300 bg-stone-50">
                            <td colspan="3" class="px-4 py-4 text-right font-semibold text-stone-700">
                                Total
                            </td>
                            <td class="px-4 py-4 text-right text-xl font-bold text-amber-800">
                                {{ total|number_format(2, ',', ' ') }} €
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="mt-6 flex justify-between items-center">
                <a
                    href="{{ path('app_catalog_index') }}"
                    class="text-sm text-stone-600 hover:text-amber-700 transition"
                >
                    ← Continuer mes achats
                </a>
            </div>

        {% endif %}

    </section>
{% endblock %}
