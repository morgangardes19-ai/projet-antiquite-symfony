{% extends 'base.html.twig' %}

{% block title %}Mon panier — Atelier d'Antan{% endblock %}

{% block body %}
    <section class="max-w-5xl mx-auto px-4 py-12">

        <h1 class="font-serif text-4xl text-stone-900 mb-8">Mon panier</h1>

        {% if lines is empty %}

            {# PANIER VIDE #}
            <div class="bg-white rounded-xl border border-stone-200 p-12 text-center">
                <p class="text-4xl mb-4" aria-hidden="true">🛒</p>
                <p class="text-stone-600 mb-6">Votre panier est vide.</p>
                <a
                    href="{{ path('app_catalog_index') }}"
                    class="inline-block px-6 py-3 rounded-lg bg-amber-700 text-white
                      font-semibold hover:bg-amber-800 transition"
                >
                    Découvrir le catalogue
                </a>
            </div>

        {% else %}

            {# PANIER REMPLI #}
            <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
                <table class="w-full text-sm">
                    <thead class="bg-stone-100 text-left text-stone-600">
                        <tr>
                            <th scope="col" class="px-4 py-3 font-medium">Pièce</th>
                            <th scope="col" class="px-4 py-3 font-medium">Prix unitaire</th>
                            <th scope="col" class="px-4 py-3 font-medium">Quantité</th>
                            <th scope="col" class="px-4 py-3 font-medium text-right">Sous-total</th>
                            <th scope="col" class="px-4 py-3">
                                <span class="sr-only">Actions</span>
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for line in lines %}
                            <tr class="border-t border-stone-200">

                                {# Pièce #}
                                <td class="px-4 py-4">
                                    <a
                                        href="{{ path('app_catalog_show', {'slug': line.product.slug}) }}"
                                        class="font-medium text-stone-900 hover:text-amber-700 transition"
                                    >
                                        {{ line.product.name }}
                                    </a>
                                </td>

                                {# Prix unitaire #}
                                <td class="px-4 py-4 text-stone-900">
                                    {{ line.product.price|number_format(2, ',', ' ') }} €
                                </td>

                                {# Quantité modifiable #}
                                <td class="px-4 py-4 text-stone-900">
                                    <form
                                        method="post"
                                        action="{{ path('app_cart_update', {'id': line.product.id}) }}"
                                        class="flex items-center gap-2"
                                    >

                                        <label for="qty-{{ line.product.id }}" class="sr-only">
                                            Quantité pour {{ line.product.name }}
                                        </label>

                                        <input
                                            type="number"
                                            id="qty-{{ line.product.id }}"
                                            name="quantity"
                                            value="{{ line.quantity }}"
                                            min="1"
                                            max="{{ line.product.stock }}"
                                            class="w-20 rounded-lg border-stone-300 text-center text-sm
                                          focus:border-amber-500 focus:ring-amber-500"
                                        >

                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('cart_update_' ~ line.product.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="text-xs font-medium text-amber-700 hover:underline"
                                        >
                                            Modifier
                                        </button>
                                    </form>
                                </td>

                                {# Sous-total #}
                                <td class="px-4 py-4 text-stone-900 text-right font-semibold">
                                    {{ line.subtotal|number_format(2, ',', ' ') }} €
                                </td>

                                {# Supprimer #}
                                <td class="px-4 py-4 text-right">
                                    <form
                                        method="post"
                                        action="{{ path('app_cart_remove', {'id': line.product.id}) }}"
                                    >

                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('cart_remove_' ~ line.product.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="text-stone-400 hover:text-red-600 transition
                                           focus:outline-none focus:ring-2 focus:ring-red-500 rounded"
                                            aria-label="Retirer {{ line.product.name }} du panier"
                                        >
                                            <span aria-hidden="true">🗑️</span>
                                        </button>
                                    </form>
                                </td>

                            </tr>
                        {% endfor %}
                    </tbody>

                    <tfoot>
                        <tr class="border-t-2 border-stone-300 bg-stone-50">
                            <td colspan="3" class="px-4 py-4 text-right font-semibold text-stone-700">
                                Total
                            </td>
                            <td class="px-4 py-4 text-right text-xl font-bold text-amber-800">
                                {{ total|number_format(2, ',', ' ') }} €
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="mt-6 flex justify-between items-center">
                <a
                    href="{{ path('app_catalog_index') }}"
                    class="text-sm text-stone-600 hover:text-amber-700 transition"
                >
                    ← Continuer mes achats
                </a>
            </div>

        {% endif %}

    </section>
{% endblock %}
