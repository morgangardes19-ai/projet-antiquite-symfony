{% extends 'base.html.twig' %}

{% block title %}Connexion — Atelier d'Antan{% endblock %}

{% block body %}

    {# ── Classes Tailwind réutilisables ── #}
    {% set inputClass = 'w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-stone-900 shadow-sm focus:border-amber-600 focus:ring-2 focus:ring-amber-500/30 focus:outline-none' %}
    {% set labelClass = 'text-sm font-medium text-stone-700 pb-1' %}

    <section class="bg-stone-300">
        <div class="max-w-xl mx-auto px-4 py-16 lg:py-24">

            <div
                class="bg-white rounded-2xl border border-stone-200 shadow-sm
                    p-8 lg:p-10 flex flex-col gap-8"
            >

                {#  EN-TÊTE DE LA CARTE #}
                <div class="flex flex-col gap-2 text-center">

                    <span class="text-amber-700 text-xs tracking-[0.3em] uppercase">
                        Atelier d'Antan
                    </span>

                    <h1 class="font-serif text-3xl text-stone-900">Connexion</h1>

                </div>

                {#  FORMULAIRE  #}
                <form method="post" class="flex flex-col gap-5">

                    {# Erreur d'authentification #}
                    {% if error %}
                        <div
                            class="rounded-lg border border-red-200 bg-red-50 px-4 py-3
                                text-sm text-red-700"
                        >
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    {# Déjà connecté #}
                    {% if app.user %}
                        <div
                            class="rounded-lg border border-stone-200 bg-stone-50 px-4 py-3
                                text-sm text-stone-600"
                        >
                            Vous êtes connecté en tant que
                            <strong class="text-stone-900">{{ app.user.userIdentifier }}</strong>.
                            <a
                                href="{{ path('app_logout') }}"
                                class="text-amber-700 font-medium hover:text-amber-800 transition"
                            >
                                Se déconnecter
                            </a>
                        </div>
                    {% endif %}

                    {# E-mail #}
                    <div class="flex flex-col">
                        <label for="username" class="{{ labelClass }}">Adresse e-mail</label>
                        <input
                            type="email"
                            value="{{ last_username }}"
                            name="_username"
                            id="username"
                            autocomplete="email"
                            placeholder="vous@exemple.fr"
                            required
                            autofocus
                            class="{{ inputClass }}"
                        >
                    </div>

                    {# Mot de passe #}
                    <div class="flex flex-col">
                        <div class="flex flex-wrap items-baseline justify-between gap-2 pb-1">
                            <label for="password" class="text-sm font-medium text-stone-700">
                                Mot de passe
                            </label>
                            <a
                                href="#"
                                class="text-xs text-stone-500 hover:text-amber-700 transition"
                            >
                                Mot de passe oublié ?
                            </a>
                        </div>
                        <input
                            type="password"
                            name="_password"
                            id="password"
                            autocomplete="current-password"
                            placeholder="••••••••"
                            required
                            class="{{ inputClass }}"
                        >
                    </div>

                    {# Se souvenir #}
                    <label class="flex items-center gap-3 text-sm text-stone-600 cursor-pointer">
                        <input
                            type="checkbox"
                            name="_remember_me"
                            class="w-4 h-4 shrink-0 rounded border-stone-300
                                  text-amber-700 focus:ring-2 focus:ring-amber-500/30"
                        >
                        Rester connecté sur cet appareil
                    </label>

                    {# Jeton CSRF #}
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    {# Bouton #}
                    <button
                        type="submit"
                        class="w-full bg-amber-700 text-white px-8 py-3 rounded-lg font-semibold
                               hover:bg-amber-800 transition
                               focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2"
                    >
                        Se connecter
                    </button>

                </form>

                {#  LIEN VERS L'INSCRIPTION #}
                <div class="border-t border-stone-200 pt-6 text-center text-sm text-stone-500">
                    Pas encore de compte ?
                    <a
                        href="{{ path('app_register') }}"
                        class="text-amber-700 font-medium hover:text-amber-800 transition"
                    >
                        Créer un compte
                    </a>
                </div>

            </div>

        </div>
    </section>

{% endblock %}
