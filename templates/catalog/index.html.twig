{% extends 'base.html.twig' %}

{% block title %}Catalogue — Atelier d'Antan{% endblock %}
{% block meta_description %}Découvrez notre catalogue d'antiquités : mobilier ancien, horlogerie, objets d'art, luminaires et céramiques d'époque.{% endblock %}

{% block body %}
    <section class="max-w-7xl mx-auto px-4 py-12">

        <header class="mb-10">
            <h1 class="text-4xl font-serif text-stone-900 mb-2">Catalogue</h1>
            <p class="text-stone-600">
                {{ total }} pièce{{ total > 1 ? 's' : '' }} disponible{{ total > 1 ? 's' : '' }}
            </p>
        </header>

        {% if products is empty %}
            <p class="bg-white rounded-xl border border-stone-200 p-8 text-center text-stone-600">
                Aucune pièce disponible pour le moment.
            </p>
        {% else %}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                {% for product in products %}
                    {{ include('partials/_product_card.html.twig', {'product': product}) }}
                {% endfor %}
            </div>
        {% endif %}

        {% if totalPages > 1 %}
            <nav aria-label="Pagination du catalogue" class="mt-12">
                <ul class="flex flex-wrap justify-center items-center gap-2">

                    <li>
                        {% if page > 1 %}
                            <a
                                href="{{ path('app_catalog_index', {'page': page - 1}) }}"
                                class="px-4 py-2 rounded-lg border border-stone-300 bg-white
                                  text-stone-700 hover:bg-stone-100 transition
                                  focus:outline-none focus:ring-2 focus:ring-amber-500"
                            >
                                ← Précédent
                            </a>
                        {% else %}
                            <span
                                class="px-4 py-2 rounded-lg border border-stone-200 text-stone-300 cursor-not-allowed"
                                aria-disabled="true"
                            >← Précédent</span>
                        {% endif %}
                    </li>

                    {% for p in 1..totalPages %}
                        <li>
                            {% if p == page %}
                                <span
                                    aria-current="page"
                                    class="px-4 py-2 rounded-lg bg-amber-700 text-white font-semibold"
                                >
                                    {{ p }}
                                </span>
                            {% else %}
                                <a
                                    href="{{ path('app_catalog_index', {'page': p}) }}"
                                    class="px-4 py-2 rounded-lg border border-stone-300 bg-white
                                      text-stone-700 hover:bg-stone-100 transition
                                      focus:outline-none focus:ring-2 focus:ring-amber-500"
                                >
                                    {{ p }}
                                </a>
                            {% endif %}
                        </li>
                    {% endfor %}

                    <li>
                        {% if page < totalPages %}
                            <a
                                href="{{ path('app_catalog_index', {'page': page + 1}) }}"
                                class="px-4 py-2 rounded-lg border border-stone-300 bg-white
                                  text-stone-700 hover:bg-stone-100 transition
                                  focus:outline-none focus:ring-2 focus:ring-amber-500"
                            >
                                Suivant →
                            </a>
                        {% else %}
                            <span
                                class="px-4 py-2 rounded-lg border border-stone-200 text-stone-300 cursor-not-allowed"
                                aria-disabled="true"
                            >Suivant →</span>
                        {% endif %}
                    </li>

                </ul>
            </nav>
        {% endif %}

    </section>
{% endblock %}
