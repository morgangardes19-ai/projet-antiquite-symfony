{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} — Atelier d'Antan{% endblock %}

{% block body %}
    <section class="max-w-7xl mx-auto px-4 py-12">
        <h1 class="text-4xl font-serif text-stone-900 mb-6">{{ product.name }}</h1>
        <p class="text-stone-600">{{ product.description }}</p>
    </section>

    {# ══════════ AJOUT AU PANIER ══════════ #}
    <div class="mt-8">

        {% if product.stock < 1 %}

            {# ─── Épuisé ─── #}
            <p class="inline-block px-6 py-3 rounded-lg bg-stone-200 text-stone-600 font-semibold">
                Épuisé
            </p>

        {% elseif remaining < 1 %}

            {# ─── Déjà tout dans le panier ─── #}
            <p
                class="inline-block px-6 py-3 rounded-lg bg-amber-50 border border-amber-200
                  text-amber-800 font-medium"
            >
                ✅ Vous avez déjà tous les exemplaires disponibles dans votre panier.
            </p>
            <p class="mt-2 text-sm">
                <a href="{{ path('app_cart_index') }}" class="text-amber-700 hover:underline">
                    Voir mon panier →
                </a>
            </p>

        {% else %}

            {# ─── Formulaire ─── #}
            {{ form_start(cartForm, {
            'attr': {'class': 'flex items-center gap-4'}
        }) }}

            <div class="flex items-center gap-2">
                <label
                    for="{{ cartForm.quantity.vars.id }}"
                    class="text-sm font-medium text-stone-700"
                >
                    Quantité
                </label>
                {{ form_widget(cartForm.quantity) }}
            </div>

            <button
                type="submit"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-lg
                           bg-amber-700 text-white font-semibold
                           hover:bg-amber-800 transition
                           focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2"
            >
                <span aria-hidden="true">🛒</span>
                Ajouter au panier
            </button>

            {{ form_end(cartForm) }}

            <p class="mt-2 text-sm text-stone-500">
                {{ remaining }} exemplaire{{ remaining > 1 ? 's' : '' }} encore disponible{{ remaining > 1 ? 's' : '' }}
                {% if remaining < product.stock %}
                    <span class="text-amber-700">
                        ({{ product.stock - remaining }} déjà dans votre panier)
                    </span>
                {% endif %}
            </p>

        {% endif %}

    </div>
{% endblock %}
