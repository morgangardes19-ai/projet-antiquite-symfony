{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} — Atelier d'Antan{% endblock %}

{% block body %}
    <section class="max-w-7xl mx-auto px-4 py-12">
        <h1 class="text-4xl font-serif text-stone-900 mb-6">{{ product.name }}</h1>
        <p class="text-stone-600">{{ product.description }}</p>
    </section>

    {% if product.stock > 0 %}
        <form
            method="post"
            action="{{ path('app_cart_add', {'id': product.id}) }}"
            class="flex flex-wrap items-end gap-4 mt-8"
        >

            <div>
                <label for="quantity" class="block text-sm font-medium text-stone-700 mb-1">Quantité</label>
                <input
                    type="number"
                    id="quantity"
                    name="quantity"
                    value="1"
                    min="1"
                    max="{{ product.stock }}"
                    class="w-24 rounded-lg border border-stone-300 px-3 py-2
                          focus:border-amber-600 focus:ring-2 focus:ring-amber-500/30 focus:outline-none"
                >
            </div>

            {# 🔒 Jeton CSRF #}
            <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">

            <button
                type="submit"
                class="bg-amber-700 text-white px-8 py-3 rounded-lg font-medium
                       hover:bg-amber-800 transition
                       focus:outline-none focus:ring-2 focus:ring-amber-500"
            >
                🛒 Ajouter au panier
            </button>
        </form>
    {% else %}
        <p class="inline-block px-4 py-2 rounded-lg bg-red-100 text-red-800 font-medium">
            Cette pièce est vendue
        </p>
    {% endif %}
{% endblock %}
