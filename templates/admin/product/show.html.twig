{% extends 'admin/base.html.twig' %}

{% block title %}{{ product.name }} — Administration{% endblock %}

{% block body %}
    <div class="w-full max-w-4xl mx-auto flex flex-col gap-8">

        {#  FIL D'ARIANE #}
        <nav
            aria-label="Fil d'Ariane"
            class="flex flex-wrap items-center gap-2 text-sm text-stone-500"
        >

            <a
                href="{{ path('admin_dashboard') }}"
                class="hover:text-amber-700 transition"
            >
                Tableau de bord
            </a>

            <span aria-hidden="true">/</span>

            <a
                href="{{ path('admin_product_index') }}"
                class="hover:text-amber-700 transition"
            >
                Produits
            </a>

            <span aria-hidden="true">/</span>

            <span class="text-stone-900 font-medium truncate">{{ product.name }}</span>

        </nav>

        {#  EN-TÊTE #}
        {#  EN-TÊTE #}
        <div
            class="flex flex-col gap-5
                border-b border-stone-200 pb-6
                md:flex-row md:items-center md:justify-between md:gap-4"
        >

            {# Vignette + titre empilés en mobile #}
            <div class="flex flex-col gap-3 md:flex-row md:items-center md:gap-4">

                <div
                    class="w-16 h-16 rounded-xl overflow-hidden bg-stone-100 shrink-0
                        border border-stone-200"
                >
                    {% set mainImage = product.productImages|first %}
                    {% if mainImage %}
                        <img
                            src="{{ asset('uploads/products/' ~ mainImage.filename) }}"
                            alt=""
                            class="w-full h-full object-cover"
                        >
                    {% else %}
                        <div
                            class="w-full h-full flex items-center justify-center
                                text-stone-300 text-xl"
                            aria-hidden="true"
                        >
                            📦
                        </div>
                    {% endif %}
                </div>

                <div class="flex flex-col gap-1 min-w-0">
                    <h1 class="font-serif text-2xl text-stone-900 break-words md:text-3xl">
                        {{ product.name }}
                    </h1>

                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-sm text-stone-500 truncate">{{ product.slug }}</span>
                        <span class="text-stone-300" aria-hidden="true">·</span>
                        <span
                            class="inline-block px-2.5 py-1 rounded-full
                                 bg-stone-100 text-stone-600 text-xs whitespace-nowrap"
                        >
                            {{ product.category.name }}
                        </span>
                    </div>
                </div>

            </div>

            {# Actions #}
            <div class="flex flex-wrap items-center gap-3">

                <a
                    href="{{ path('admin_product_edit', {'id': product.id}) }}"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg
                      bg-amber-700 text-white text-sm font-semibold
                      hover:bg-amber-800 transition
                      focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2"
                >
                    <span aria-hidden="true">✏️</span>
                    Modifier
                </a>

                <a
                    href="{{ path('admin_product_index') }}"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg
                      border border-stone-300 bg-white text-stone-700 text-sm font-medium
                      hover:bg-stone-100 transition
                      focus:outline-none focus:ring-2 focus:ring-stone-400"
                >
                    <span aria-hidden="true">←</span>
                    Retour à la liste
                </a>

            </div>

        </div>

        {#  PRIX & STOCK #}
        <div class="flex flex-wrap gap-6">

            {# Prix #}
            <div
                class="grow basis-64 bg-white rounded-xl border border-stone-200
                    shadow-sm p-6 flex flex-col gap-1"
            >
                <span class="text-xs uppercase tracking-wider text-stone-500">Prix</span>
                <span class="font-serif text-2xl text-stone-900">
                    {{ product.price|number_format(2, ',', ' ') }} €
                </span>
            </div>

            {# Stock #}
            <div
                class="grow basis-64 bg-white rounded-xl border border-stone-200
                    shadow-sm p-6 flex flex-col gap-1"
            >
                <span class="text-xs uppercase tracking-wider text-stone-500">Stock</span>

                {% if product.stock < 1 %}
                    <span class="font-serif text-2xl text-red-600">Épuisé</span>
                    <span class="text-xs text-red-500">À réapprovisionner</span>
                {% elseif product.stock <= 2 %}
                    <span class="font-serif text-2xl text-amber-600">{{ product.stock }}</span>
                    <span class="text-xs text-amber-600">Stock faible</span>
                {% else %}
                    <span class="font-serif text-2xl text-green-700">{{ product.stock }}</span>
                    <span class="text-xs text-green-600">Disponible</span>
                {% endif %}
            </div>

        </div>

        {#  DESCRIPTION #}
        <fieldset class="bg-white rounded-xl border border-stone-200 shadow-sm p-6">
            <legend class="px-3 text-lg font-serif font-semibold text-stone-900">
                Description
            </legend>

            <p class="pt-2 text-sm text-stone-700 leading-relaxed">
                {{ product.description ?: '—' }}
            </p>
        </fieldset>

        {#  CARACTÉRISTIQUES  #}
        <fieldset class="bg-white rounded-xl border border-stone-200 shadow-sm p-6">
            <legend class="px-3 text-lg font-serif font-semibold text-stone-900">
                Caractéristiques
            </legend>

            <dl class="flex flex-wrap gap-6 pt-2">

                <div class="grow basis-64 flex flex-col gap-1">
                    <dt class="text-xs uppercase tracking-wider text-stone-500">Matériau</dt>
                    <dd class="text-sm text-stone-900">{{ product.material ?: '—' }}</dd>
                </div>

                <div class="grow basis-64 flex flex-col gap-1">
                    <dt class="text-xs uppercase tracking-wider text-stone-500">Style</dt>
                    <dd class="text-sm text-stone-900">{{ product.style ?: '—' }}</dd>
                </div>

                <div class="grow basis-64 flex flex-col gap-1">
                    <dt class="text-xs uppercase tracking-wider text-stone-500">Origine</dt>
                    <dd class="text-sm text-stone-900">{{ product.origin ?: '—' }}</dd>
                </div>

                <div class="grow basis-64 flex flex-col gap-1">
                    <dt class="text-xs uppercase tracking-wider text-stone-500">Couleur</dt>
                    <dd class="text-sm text-stone-900">{{ product.color ?: '—' }}</dd>
                </div>

                <div class="grow basis-64 flex flex-col gap-1">
                    <dt class="text-xs uppercase tracking-wider text-stone-500">Dimensions</dt>
                    <dd class="text-sm text-stone-900">{{ product.size ?: '—' }}</dd>
                </div>

                <div class="grow basis-64 flex flex-col gap-1">
                    <dt class="text-xs uppercase tracking-wider text-stone-500">Poids</dt>
                    <dd class="text-sm text-stone-900">{{ product.weight ?: '—' }}</dd>
                </div>

            </dl>
        </fieldset>

        {#  PHOTOGRAPHIES #}
        <fieldset class="bg-white rounded-xl border border-stone-200 shadow-sm p-6">
            <legend class="px-3 text-lg font-serif font-semibold text-stone-900">
                Photographies ({{ product.productImages|length }})
            </legend>

            <div class="pt-2">

                {% if product.productImages is empty %}

                    <div class="py-10 text-center">
                        <p class="text-3xl mb-3" aria-hidden="true">🖼️</p>
                        <p class="text-sm text-stone-500 mb-6">
                            Aucune photographie pour cette pièce.
                        </p>
                        <a
                            href="{{ path('admin_product_edit', {'id': product.id}) }}"
                            class="inline-block px-5 py-2.5 rounded-lg bg-amber-700 text-white
                              text-sm font-semibold hover:bg-amber-800 transition"
                        >
                            Ajouter des photos
                        </a>
                    </div>

                {% else %}

                    <div class="flex flex-wrap gap-4">
                        {% for image in product.productImages %}
                            <div class="grow basis-40 flex flex-col gap-2">

                                <div
                                    class="aspect-square rounded-lg overflow-hidden
                                        bg-stone-100 border border-stone-200"
                                >
                                    <img
                                        src="{{ asset('uploads/products/' ~ image.filename) }}"
                                        alt="{{ product.name }} — visuel {{ loop.index }}"
                                        loading="lazy"
                                        class="w-full h-full object-cover"
                                    >
                                </div>

                                <span class="text-xs text-stone-400 text-center break-all">
                                    {{ image.filename }}
                                </span>

                            </div>
                        {% endfor %}
                    </div>

                {% endif %}

            </div>
        </fieldset>

        {#  INFORMATIONS TECHNIQUES #}
        <fieldset class="bg-white rounded-xl border border-stone-200 shadow-sm p-6">
            <legend class="px-3 text-lg font-serif font-semibold text-stone-900">
                Informations techniques
            </legend>

            <dl class="flex flex-wrap gap-6 pt-2">

                <div class="grow basis-64 flex flex-col gap-1">
                    <dt class="text-xs uppercase tracking-wider text-stone-500">Identifiant</dt>
                    <dd class="text-sm font-mono text-stone-600">{{ product.id }}</dd>
                </div>

                <div class="grow basis-64 flex flex-col gap-1">
                    <dt class="text-xs uppercase tracking-wider text-stone-500">Identifiant URL</dt>
                    <dd class="text-sm font-mono text-stone-600 break-all">{{ product.slug }}</dd>
                </div>
                
            </dl>
        </fieldset>

    </div>
{% endblock %}
