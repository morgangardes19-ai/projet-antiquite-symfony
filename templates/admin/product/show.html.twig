{% extends 'base.html.twig' %}

{% block title %}Product{% endblock %}

{% block body %}
    <h1>Product</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ product.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ product.name }}</td>
            </tr>
            <tr>
                <th>Slug</th>
                <td>{{ product.slug }}</td>
            </tr>
            <tr>
                <th>Color</th>
                <td>{{ product.color }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ product.description }}</td>
            </tr>
            <tr>
                <th>Material</th>
                <td>{{ product.material }}</td>
            </tr>
            <tr>
                <th>Style</th>
                <td>{{ product.style }}</td>
            </tr>
            <tr>
                <th>Origin</th>
                <td>{{ product.origin }}</td>
            </tr>
            <tr>
                <th>Stock</th>
                <td>{{ product.stock }}</td>
            </tr>
            <tr>
                <th>Size</th>
                <td>{{ product.size }}</td>
            </tr>
            <tr>
                <th>Weight</th>
                <td>{{ product.weight }}</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>{{ product.price }}</td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ product.createdAt ? product.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <h2 class="text-xl font-semibold mt-8 mb-4">Photos</h2>

    {% if product.productImages is empty %}
        <p class="text-stone-500">Aucune photo pour cette pièce.</p>
    {% else %}
        <div class="flex flex-wrap gap-4">
            {% for image in product.productImages %}
                <img
                    src="{{ asset('uploads/products/' ~ image.filename) }}"
                    alt="Photo de {{ product.name }}"
                    width="200"
                    height="200"
                    class="w-48 h-48 object-cover rounded-lg border border-stone-200"
                >
            {% endfor %}
        </div>
    {% endif %}

    <a href="{{ path('admin_product_index') }}">back to list</a>

    <a href="{{ path('admin_product_edit', {'id': product.id}) }}">edit</a>

    {{ include('admin/product/_delete_form.html.twig') }}
{% endblock %}
