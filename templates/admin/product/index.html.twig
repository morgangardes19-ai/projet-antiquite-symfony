{% extends 'base.html.twig' %}

{% block title %}Produits — Administration{% endblock %}

{% block body %}
    <div class="flex flex-col gap-8">

        {#  EN-TÊTE  #}
        <div class="flex flex-wrap items-center justify-between gap-4">

            <div class="flex flex-col gap-1">
                <h1 class="font-serif text-3xl text-stone-900">Produits</h1>
                <p class="text-sm text-stone-500">
                    {{ products|length }} pièce{{ products|length > 1 ? 's' : '' }} au catalogue
                </p>
            </div>

            <a
                href="{{ path('admin_product_new') }}"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg
                  bg-amber-700 text-white text-sm font-semibold
                  hover:bg-amber-800 transition
                  focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2"
            >
                <span aria-hidden="true">＋</span>
                Nouveau produit
            </a>

        </div>

        {#  TABLEAU  #}
        {% if products is empty %}

            <div class="bg-white rounded-xl border border-stone-200 p-16 text-center">
                <p class="text-4xl mb-4" aria-hidden="true">📦</p>
                <p class="text-stone-600 mb-6">Aucun produit au catalogue.</p>
                <a
                    href="{{ path('admin_product_new') }}"
                    class="inline-block px-6 py-3 rounded-lg bg-amber-700 text-white
                      font-semibold hover:bg-amber-800 transition"
                >
                    Créer le premier produit
                </a>
            </div>

        {% else %}

            <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">

                        <thead
                            class="bg-stone-50 text-left text-xs uppercase
                                  tracking-wider text-stone-500"
                        >
                            <tr>
                                <th scope="col" class="px-4 py-3 font-medium">Pièce</th>
                                <th scope="col" class="px-4 py-3 font-medium">Catégorie</th>
                                <th scope="col" class="px-4 py-3 font-medium text-right">Prix</th>
                                <th scope="col" class="px-4 py-3 font-medium text-center">Stock</th>
                                <th scope="col" class="px-4 py-3 font-medium text-right">
                                    <span class="sr-only">Actions</span>
                                </th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-stone-100">
                            {% for product in products %}
                                <tr class="hover:bg-stone-50 transition">

                                    {# Pièce #}
                                    <td class="px-4 py-3">
                                        <div class="flex items-center gap-3">

                                            <div
                                                class="w-12 h-12 rounded-lg overflow-hidden
                                                    bg-stone-100 shrink-0"
                                            >
                                                {% set image = product.productImages|first %}
                                                {% if image %}
                                                    <img
                                                        src="{{ asset('uploads/products/' ~ image.filename) }}"
                                                        alt=""
                                                        loading="lazy"
                                                        class="w-full h-full object-cover"
                                                    >
                                                {% else %}
                                                    <div
                                                        class="w-full h-full flex items-center
                                                            justify-center text-stone-300 text-xs"
                                                    >
                                                        —
                                                    </div>
                                                {% endif %}
                                            </div>

                                            <div class="flex flex-col min-w-0">
                                                <span class="font-medium text-stone-900 truncate">
                                                    {{ product.name }}
                                                </span>
                                                <span class="text-xs text-stone-400 truncate">
                                                    {{ product.slug }}
                                                </span>
                                            </div>

                                        </div>
                                    </td>

                                    {# Catégorie #}
                                    <td class="px-4 py-3">
                                        <span
                                            class="inline-block px-2.5 py-1 rounded-full
                                                 bg-stone-100 text-stone-600 text-xs whitespace-nowrap"
                                        >
                                            {{ product.category.name }}
                                        </span>
                                    </td>

                                    {# Prix #}
                                    <td
                                        class="px-4 py-3 text-right font-medium text-stone-900
                                           whitespace-nowrap"
                                    >
                                        {{ product.price|number_format(2, ',', ' ') }} €
                                    </td>

                                    {# Stock #}
                                    <td class="px-4 py-3 text-center">
                                        {% if product.stock < 1 %}
                                            <span
                                                class="inline-block px-2.5 py-1 rounded-full
                                                     bg-red-50 text-red-700 text-xs font-medium"
                                            >
                                                Épuisé
                                            </span>
                                        {% elseif product.stock <= 2 %}
                                            <span
                                                class="inline-block px-2.5 py-1 rounded-full
                                                     bg-amber-50 text-amber-700 text-xs font-medium"
                                            >
                                                {{ product.stock }}
                                            </span>
                                        {% else %}
                                            <span
                                                class="inline-block px-2.5 py-1 rounded-full
                                                     bg-green-50 text-green-700 text-xs font-medium"
                                            >
                                                {{ product.stock }}
                                            </span>
                                        {% endif %}
                                    </td>

                                    {# Actions #}
                                    <td class="px-4 py-3">
                                        <div class="flex items-center justify-end gap-1">

                                            <a
                                                href="{{ path('admin_product_edit', {'id': product.id}) }}"
                                                class="p-2 rounded-lg text-stone-500
                                                  hover:bg-stone-100 hover:text-amber-700 transition
                                                  focus:outline-none focus:ring-2 focus:ring-amber-500"
                                                aria-label="Modifier {{ product.name }}"
                                            >
                                                <span aria-hidden="true">✏️</span>
                                            </a>

                                            <form
                                                method="post"
                                                action="{{ path('admin_product_delete', {'id': product.id}) }}"
                                                onsubmit="return confirm('Supprimer « {{ product.name }} » ? Cette action est irréversible.');"
                                            >

                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('delete' ~ product.id) }}"
                                                >

                                                <button
                                                    type="submit"
                                                    class="p-2 rounded-lg text-stone-500
                                                           hover:bg-red-50 hover:text-red-600 transition
                                                           focus:outline-none focus:ring-2 focus:ring-red-500"
                                                    aria-label="Supprimer {{ product.name }}"
                                                >
                                                    <span aria-hidden="true">🗑️</span>
                                                </button>
                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            {% endfor %}
                        </tbody>

                    </table>
                </div>
            </div>

        {% endif %}

    </div>
{% endblock %}
