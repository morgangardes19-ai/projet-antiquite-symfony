{% extends 'admin/base.html.twig' %}

{% block title %}Produits — Administration{% endblock %}

{% block body %}
    <div class="flex flex-col gap-8">

        {#  EN-TÊTE  #}
        <div class="flex flex-wrap items-center justify-between gap-4">

            <div class="flex flex-col gap-1">
                <h1 class="font-serif text-3xl text-stone-900">Produits</h1>
                <p class="text-sm text-stone-500">
                    {{ products|length }} pièce{{ products|length > 1 ? 's' : '' }} au catalogue
                </p>
            </div>

            <a
                href="{{ path('admin_product_new') }}"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg
                  bg-amber-700 text-white text-sm font-semibold
                  hover:bg-amber-800 transition
                  focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2"
            >
                <span aria-hidden="true">＋</span>
                Nouveau produit
            </a>

        </div>

        {#  LISTE  #}
        {% if products is empty %}

            <div class="bg-white rounded-xl border border-stone-200 p-16 text-center">
                <p class="text-4xl mb-4" aria-hidden="true">📦</p>
                <p class="text-stone-600 mb-6">Aucun produit au catalogue.</p>
                <a
                    href="{{ path('admin_product_new') }}"
                    class="inline-block px-6 py-3 rounded-lg bg-amber-700 text-white
                      font-semibold hover:bg-amber-800 transition"
                >
                    Créer le premier produit
                </a>
            </div>

        {% else %}

            <div class="flex flex-col gap-2">

                {# EN-TÊTE DE COLONNES — desktop uniquement #}
                <div
                    class="hidden md:flex md:items-center md:gap-4 px-4 py-2
                            text-xs uppercase tracking-wider text-stone-500"
                >
                    <span class="grow basis-0">Pièce</span>
                    <span class="w-28">Catégorie</span>
                    <span class="w-24 text-right">Prix</span>
                    <span class="w-16 text-center">Stock</span>
                    <span class="w-32 text-right"><span class="sr-only">Actions</span></span>
                </div>

                {# CARTES #}
                <ul class="flex flex-col gap-4">
                    {% for product in products %}
                        <li
                            class="flex flex-col gap-3 p-4
                                   bg-white rounded-xl border border-stone-200
                                   md:flex-row md:items-center md:gap-4 md:px-4 md:py-3"
                        >

                            {# PIÈCE #}
                            <div
                                class="flex items-center gap-3 min-w-0
                                        border-b border-stone-100 pb-3
                                        md:border-0 md:pb-0 md:grow md:basis-0"
                            >

                                <div
                                    class="w-12 h-12 rounded-lg overflow-hidden
                                            bg-stone-100 shrink-0"
                                >
                                    {% set image = product.productImages|first %}
                                    {% if image %}
                                        <img
                                            src="{{ asset('uploads/products/' ~ image.filename) }}"
                                            alt=""
                                            loading="lazy"
                                            class="w-full h-full object-cover"
                                        >
                                    {% else %}
                                        <div
                                            class="w-full h-full flex items-center
                                                    justify-center text-stone-300 text-xs"
                                        >
                                            —
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="flex flex-col min-w-0">
                                    <span class="font-medium text-stone-900 truncate">
                                        {{ product.name }}
                                    </span>
                                    <span class="text-xs text-stone-400 truncate">
                                        {{ product.slug }}
                                    </span>
                                </div>

                            </div>

                            {# CATÉGORIE #}
                            <div class="flex items-center justify-between gap-3 md:w-28">
                                <span
                                    class="text-xs font-medium uppercase tracking-wide
                                             text-stone-500 md:hidden"
                                >
                                    Catégorie
                                </span>
                                <span
                                    class="inline-block px-2.5 py-1 rounded-full
                                         bg-stone-100 text-stone-600 text-xs whitespace-nowrap"
                                >
                                    {{ product.category.name }}
                                </span>
                            </div>

                            {# PRIX #}
                            <div
                                class="flex items-center justify-between gap-3
                                        md:w-24 md:justify-end"
                            >
                                <span
                                    class="text-xs font-medium uppercase tracking-wide
                                             text-stone-500 md:hidden"
                                >
                                    Prix
                                </span>
                                <span class="font-medium text-stone-900 whitespace-nowrap">
                                    {{ product.price|number_format(2, ',', ' ') }} €
                                </span>
                            </div>

                            {# STOCK #}
                            <div
                                class="flex items-center justify-between gap-3
                                        md:w-16 md:justify-center"
                            >
                                <span
                                    class="text-xs font-medium uppercase tracking-wide
                                             text-stone-500 md:hidden"
                                >
                                    Stock
                                </span>

                                {% if product.stock < 1 %}
                                    <span
                                        class="inline-block px-2.5 py-1 rounded-full
                                             bg-red-50 text-red-700 text-xs font-medium"
                                    >
                                        Épuisé
                                    </span>
                                {% elseif product.stock <= 2 %}
                                    <span
                                        class="inline-block px-2.5 py-1 rounded-full
                                             bg-amber-50 text-amber-700 text-xs font-medium"
                                    >
                                        {{ product.stock }}
                                    </span>
                                {% else %}
                                    <span
                                        class="inline-block px-2.5 py-1 rounded-full
                                             bg-green-50 text-green-700 text-xs font-medium"
                                    >
                                        {{ product.stock }}
                                    </span>
                                {% endif %}
                            </div>

                            {# ACTIONS #}
                            <div
                                class="flex items-center justify-between gap-3
                                        border-t border-stone-100 pt-3
                                        md:border-0 md:pt-0 md:w-32 md:justify-end"
                            >

                                <span
                                    class="text-xs font-medium uppercase tracking-wide
                                             text-stone-500 md:hidden"
                                >
                                    Actions
                                </span>

                                <div class="flex items-center gap-1">

                                    <a
                                        href="{{ path('admin_product_show', {'id': product.id}) }}"
                                        class="p-2 rounded-lg text-stone-500
                                          hover:bg-stone-100 hover:text-amber-700 transition
                                          focus:outline-none focus:ring-2 focus:ring-amber-500"
                                        aria-label="Voir {{ product.name }}"
                                    >
                                        <span aria-hidden="true">👁️</span>
                                    </a>

                                    <a
                                        href="{{ path('admin_product_edit', {'id': product.id}) }}"
                                        class="p-2 rounded-lg text-stone-500
                                          hover:bg-stone-100 hover:text-amber-700 transition
                                          focus:outline-none focus:ring-2 focus:ring-amber-500"
                                        aria-label="Modifier {{ product.name }}"
                                    >
                                        <span aria-hidden="true">✏️</span>
                                    </a>

                                    <form
                                        method="post"
                                        action="{{ path('admin_product_delete', {'id': product.id}) }}"
                                        onsubmit="return confirm('Supprimer « {{ product.name|e('js') }} » ? Cette action est irréversible.');"
                                    >

                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('delete' ~ product.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="p-2 rounded-lg text-stone-500
                                                   hover:bg-red-50 hover:text-red-600 transition
                                                   focus:outline-none focus:ring-2 focus:ring-red-500"
                                            aria-label="Supprimer {{ product.name }}"
                                        >
                                            <span aria-hidden="true">🗑️</span>
                                        </button>
                                    </form>

                                </div>
                            </div>

                        </li>
                    {% endfor %}
                </ul>

            </div>

        {% endif %}

    </div>
{% endblock %}
