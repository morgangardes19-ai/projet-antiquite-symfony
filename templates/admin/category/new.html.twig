{% extends 'base.html.twig' %}

{% block title %}Nouvelle catégorie — Administration{% endblock %}

{% block body %}
    <div class="w-full max-w-4xl mx-auto flex flex-col gap-8">

        {#  FIL D'ARIANE  #}
        <nav
            aria-label="Fil d'Ariane"
            class="flex flex-wrap items-center gap-2 text-sm text-stone-500"
        >

            <a
                href="{{ path('admin_dashboard') }}"
                class="hover:text-amber-700 transition"
            >
                Tableau de bord
            </a>

            <span aria-hidden="true">/</span>

            <a
                href="{{ path('admin_category_index') }}"
                class="hover:text-amber-700 transition"
            >
                Catégories
            </a>

            <span aria-hidden="true">/</span>

            <span class="text-stone-900 font-medium">Nouvelle catégorie</span>

        </nav>

        {#  EN-TÊTE  #}
        <div
            class="flex flex-wrap items-center justify-between gap-4
                border-b border-stone-200 pb-6"
        >

            <div class="flex flex-col gap-1">
                <h1 class="font-serif text-3xl text-stone-900">Nouvelle catégorie</h1>
                <p class="text-sm text-stone-500">
                    Créez un nouvel univers pour classer vos pièces.
                </p>
            </div>

            <a
                href="{{ path('admin_category_index') }}"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg
                  border border-stone-300 bg-white text-stone-700 text-sm font-medium
                  hover:bg-stone-100 transition
                  focus:outline-none focus:ring-2 focus:ring-stone-400"
            >
                <span aria-hidden="true">←</span>
                Retour à la liste
            </a>

        </div>

        {#  FORMULAIRE #}
        {{ include('admin/category/_form.html.twig') }}

    </div>
{% endblock %}
