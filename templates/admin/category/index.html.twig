{% extends 'admin/base.html.twig' %}

{% block title %}Catégories — Administration{% endblock %}

{% block body %}
    <div class="flex flex-col gap-8">

        {# EN-TÊTE #}
        <div
            class="flex flex-wrap items-center justify-between gap-4
                border-b border-stone-200 pb-6"
        >

            <div class="flex flex-col gap-1">
                <h1 class="font-serif text-3xl text-stone-900">Catégories</h1>
                <p class="text-sm text-stone-500">
                    {{ categories|length }} catégorie{{ categories|length > 1 ? 's' : '' }}
                    dans le catalogue
                </p>
            </div>

            <a
                href="{{ path('admin_category_new') }}"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg
                  bg-amber-700 text-white text-sm font-semibold
                  hover:bg-amber-800 transition
                  focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2"
            >
                <span aria-hidden="true">＋</span>
                Nouvelle catégorie
            </a>

        </div>

        {# LISTE #}
        {% if categories is empty %}

            <div class="bg-white rounded-xl border border-stone-200 p-16 text-center">
                <p class="text-4xl mb-4" aria-hidden="true">🏷️</p>
                <p class="text-stone-600 mb-6">Aucune catégorie enregistrée.</p>
                <a
                    href="{{ path('admin_category_new') }}"
                    class="inline-block px-6 py-3 rounded-lg bg-amber-700 text-white
                      font-semibold hover:bg-amber-800 transition"
                >
                    Créer la première catégorie
                </a>
            </div>

        {% else %}

            <div class="flex flex-col gap-2">

                {# EN-TÊTE DE COLONNES — desktop uniquement #}
                <div
                    class="hidden md:flex md:items-center md:gap-4 px-4 py-2
                            text-xs uppercase tracking-wider text-stone-500"
                >
                    <span class="grow basis-0">Catégorie</span>
                    <span class="w-56">Description</span>
                    <span class="w-20 text-center">Produits</span>
                    <span class="w-32 text-right"><span class="sr-only">Actions</span></span>
                </div>

                {# CARTES #}
                <ul class="flex flex-col gap-4">
                    {% for category in categories %}
                        <li
                            class="flex flex-col gap-3 p-4
                                   bg-white rounded-xl border border-stone-200
                                   md:flex-row md:items-center md:gap-4 md:px-4 md:py-3"
                        >

                            {# CATÉGORIE - titre de la carte #}
                            <div
                                class="flex items-center gap-3 min-w-0
                                        border-b border-stone-100 pb-3
                                        md:border-0 md:pb-0 md:grow md:basis-0"
                            >

                                <div
                                    class="w-10 h-10 rounded-lg bg-amber-100
                                        text-amber-800 font-serif font-semibold
                                        flex items-center justify-center shrink-0"
                                    aria-hidden="true"
                                >
                                    {{ category.name|first|upper }}
                                </div>

                                <div class="flex flex-col min-w-0">
                                    <span class="font-medium text-stone-900 truncate">
                                        {{ category.name }}
                                    </span>
                                </div>

                            </div>

                            {# DESCRIPTION #}
                            <div class="flex items-start justify-between gap-3 md:w-56">
                                <span
                                    class="shrink-0 text-xs font-medium uppercase tracking-wide
                                             text-stone-500 md:hidden"
                                >
                                    Description
                                </span>
                                <span class="line-clamp-2 text-sm text-stone-600">
                                    {{ category.description }}
                                </span>
                            </div>

                            {# NOMBRE DE PRODUITS #}
                            <div
                                class="flex items-center justify-between gap-3
                                        md:w-20 md:justify-center"
                            >
                                <span
                                    class="text-xs font-medium uppercase tracking-wide
                                             text-stone-500 md:hidden"
                                >
                                    Produits
                                </span>

                                {% set count = category.products|length %}
                                {% if count > 0 %}
                                    <span
                                        class="inline-block px-2.5 py-1 rounded-full
                                             bg-green-50 text-green-700 text-xs font-medium"
                                    >
                                        {{ count }}
                                    </span>
                                {% else %}
                                    <span
                                        class="inline-block px-2.5 py-1 rounded-full
                                             bg-stone-100 text-stone-500 text-xs"
                                    >
                                        vide
                                    </span>
                                {% endif %}
                            </div>

                            {# ACTIONS #}
                            <div
                                class="flex items-center justify-between gap-3
                                        border-t border-stone-100 pt-3
                                        md:border-0 md:pt-0 md:w-32 md:justify-end"
                            >

                                <span
                                    class="text-xs font-medium uppercase tracking-wide
                                             text-stone-500 md:hidden"
                                >
                                    Actions
                                </span>

                                <div class="flex items-center gap-1">

                                    <a
                                        href="{{ path('admin_category_show', {'id': category.id}) }}"
                                        class="p-2 rounded-lg text-stone-500
                                          hover:bg-stone-100 hover:text-amber-700 transition
                                          focus:outline-none focus:ring-2 focus:ring-amber-500"
                                        aria-label="Voir {{ category.name }}"
                                    >
                                        <span aria-hidden="true">👁️</span>
                                    </a>

                                    <a
                                        href="{{ path('admin_category_edit', {'id': category.id}) }}"
                                        class="p-2 rounded-lg text-stone-500
                                          hover:bg-stone-100 hover:text-amber-700 transition
                                          focus:outline-none focus:ring-2 focus:ring-amber-500"
                                        aria-label="Modifier {{ category.name }}"
                                    >
                                        <span aria-hidden="true">✏️</span>
                                    </a>

                                    <form
                                        method="post"
                                        action="{{ path('admin_category_delete', {'id': category.id}) }}"
                                        onsubmit="return confirm('Supprimer « {{ category.name|e('js') }} » ? Les produits liés pourraient être affectés.');"
                                    >

                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('delete' ~ category.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="p-2 rounded-lg text-stone-500
                                                   hover:bg-red-50 hover:text-red-600 transition
                                                   focus:outline-none focus:ring-2 focus:ring-red-500"
                                            aria-label="Supprimer {{ category.name }}"
                                        >
                                            <span aria-hidden="true">🗑️</span>
                                        </button>
                                    </form>

                                </div>
                            </div>

                        </li>
                    {% endfor %}
                </ul>

            </div>

        {% endif %}

    </div>
{% endblock %}
