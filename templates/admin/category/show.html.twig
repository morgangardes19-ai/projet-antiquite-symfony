{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} — Administration{% endblock %}

{% block body %}
    <div class="w-full max-w-4xl mx-auto flex flex-col gap-8">

        {#  FIL D'ARIANE #}
        <nav
            aria-label="Fil d'Ariane"
            class="flex flex-wrap items-center gap-2 text-sm text-stone-500"
        >

            <a
                href="{{ path('admin_dashboard') }}"
                class="hover:text-amber-700 transition"
            >
                Tableau de bord
            </a>

            <span aria-hidden="true">/</span>

            <a
                href="{{ path('admin_category_index') }}"
                class="hover:text-amber-700 transition"
            >
                Catégories
            </a>

            <span aria-hidden="true">/</span>

            <span class="text-stone-900 font-medium truncate">{{ category.name }}</span>

        </nav>

        {#  EN-TÊTE #}
        <div
            class="flex flex-wrap items-center justify-between gap-4
                border-b border-stone-200 pb-6"
        >

            <div class="flex items-center gap-4">

                <div
                    class="w-14 h-14 rounded-xl bg-amber-100 text-amber-800
                        font-serif text-2xl font-semibold
                        flex items-center justify-center shrink-0"
                    aria-hidden="true"
                >
                    {{ category.name|first|upper }}
                </div>

                <div class="flex flex-col gap-1 min-w-0">
                    <h1 class="font-serif text-3xl text-stone-900 truncate">{{ category.name }}</h1>
                    <p class="text-sm text-stone-500">
                        {{ category.products|length }}
                        pièce{{ category.products|length > 1 ? 's' : '' }} dans cette catégorie
                    </p>
                </div>

            </div>

            <div class="flex flex-wrap items-center gap-3">

                <a
                    href="{{ path('admin_category_edit', {'id': category.id}) }}"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg
                      bg-amber-700 text-white text-sm font-semibold
                      hover:bg-amber-800 transition
                      focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2"
                >
                    <span aria-hidden="true">✏️</span>
                    Modifier
                </a>

                <a
                    href="{{ path('admin_category_index') }}"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg
                      border border-stone-300 bg-white text-stone-700 text-sm font-medium
                      hover:bg-stone-100 transition
                      focus:outline-none focus:ring-2 focus:ring-stone-400"
                >
                    <span aria-hidden="true">←</span>
                    Retour à la liste
                </a>

            </div>

        </div>

        {#  INFORMATIONS #}
        <fieldset class="bg-white rounded-xl border border-stone-200 shadow-sm p-6">
            <legend class="px-3 text-lg font-serif font-semibold text-stone-900">
                Informations
            </legend>

            <dl class="flex flex-col gap-5 pt-2">

                <div class="flex flex-wrap items-baseline gap-2">
                    <dt class="w-36 shrink-0 text-sm text-stone-500">Nom</dt>
                    <dd class="text-sm font-medium text-stone-900">{{ category.name }}</dd>
                </div>

                <div class="flex flex-wrap items-baseline gap-2">
                    <dt class="w-36 shrink-0 text-sm text-stone-500">Identifiant URL</dt>
                    <dd class="text-sm font-mono text-stone-600">{{ category.slug }}</dd>
                </div>

                <div class="flex flex-wrap items-baseline gap-2">
                    <dt class="w-36 shrink-0 text-sm text-stone-500">Créée le</dt>
                    <dd class="text-sm text-stone-900">
                        {{ category.createdAt ? category.createdAt|date('d/m/Y à H:i') : '—' }}
                    </dd>
                </div>

                <div class="flex flex-col gap-1">
                    <dt class="text-sm text-stone-500">Description</dt>
                    <dd class="text-sm text-stone-900 leading-relaxed">
                        {{ category.description ?: '—' }}
                    </dd>
                </div>

            </dl>
        </fieldset>

        {#  PIÈCES DE CETTE CATÉGORIE #}
        <fieldset class="bg-white rounded-xl border border-stone-200 shadow-sm p-6">
            <legend class="px-3 text-lg font-serif font-semibold text-stone-900">
                Pièces de cette catégorie
            </legend>

            <div class="pt-2">

                {% if category.products is empty %}

                    <div class="py-10 text-center">
                        <p class="text-3xl mb-3" aria-hidden="true">📦</p>
                        <p class="text-sm text-stone-500 mb-6">
                            Aucune pièce n'est rattachée à cette catégorie.
                        </p>
                        <a
                            href="{{ path('admin_product_new') }}"
                            class="inline-block px-5 py-2.5 rounded-lg bg-amber-700 text-white
                              text-sm font-semibold hover:bg-amber-800 transition"
                        >
                            Ajouter une pièce
                        </a>
                    </div>

                {% else %}

                    <ul class="flex flex-col divide-y divide-stone-100">
                        {% for product in category.products %}
                            <li>
                                <a
                                    href="{{ path('admin_product_edit', {'id': product.id}) }}"
                                    class="flex items-center gap-4 p-3 rounded-lg
                                      hover:bg-stone-50 transition
                                      focus:outline-none focus:ring-2 focus:ring-amber-500"
                                >

                                    <div
                                        class="w-10 h-10 rounded-lg overflow-hidden
                                            bg-stone-100 shrink-0"
                                    >
                                        {% set image = product.productImages|first %}
                                        {% if image %}
                                            <img
                                                src="{{ asset('uploads/products/' ~ image.filename) }}"
                                                alt=""
                                                loading="lazy"
                                                class="w-full h-full object-cover"
                                            >
                                        {% endif %}
                                    </div>

                                    <div class="flex flex-col min-w-0 flex-1">
                                        <span class="text-sm font-medium text-stone-900 truncate">
                                            {{ product.name }}
                                        </span>
                                        <span class="text-xs text-stone-400 truncate">
                                            {{ product.slug }}
                                        </span>
                                    </div>

                                    <span class="text-sm font-medium text-stone-900 whitespace-nowrap">
                                        {{ product.price|number_format(2, ',', ' ') }} €
                                    </span>

                                    <span class="text-stone-300" aria-hidden="true">→</span>

                                </a>
                            </li>
                        {% endfor %}
                    </ul>

                {% endif %}

            </div>
        </fieldset>

    </div>
{% endblock %}
