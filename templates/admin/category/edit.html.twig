{% extends 'base.html.twig' %}

{% block title %}Modifier {{ category.name }} — Administration{% endblock %}

{% block body %}
<div class="w-full max-w-4xl mx-auto flex flex-col gap-8">

    {#  FIL D'ARIANE  #}
    <nav aria-label="Fil d'Ariane"
         class="flex flex-wrap items-center gap-2 text-sm text-stone-500">

        <a href="{{ path('admin_dashboard') }}"
           class="hover:text-amber-700 transition">
            Tableau de bord
        </a>

        <span aria-hidden="true">/</span>

        <a href="{{ path('admin_category_index') }}"
           class="hover:text-amber-700 transition">
            Catégories
        </a>

        <span aria-hidden="true">/</span>

        <span class="text-stone-900 font-medium truncate">{{ category.name }}</span>

    </nav>

    {#  EN-TÊTE  #}
    <div class="flex flex-wrap items-center justify-between gap-4
                border-b border-stone-200 pb-6">

        <div class="flex flex-col gap-1">
            <h1 class="font-serif text-3xl text-stone-900">Modifier la catégorie</h1>
            <p class="text-sm text-stone-500">{{ category.name }}</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">

            {# Supprimer #}
            <form method="post"
                  action="{{ path('admin_category_delete', {'id': category.id}) }}"
                  onsubmit="return confirm('Supprimer « {{ category.name }} » ? Les produits liés pourraient être affectés.');">

                <input type="hidden"
                       name="_token"
                       value="{{ csrf_token('delete' ~ category.id) }}">

                <button type="submit"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg
                               border border-red-200 bg-white text-red-600 text-sm font-medium
                               hover:bg-red-50 transition
                               focus:outline-none focus:ring-2 focus:ring-red-500">
                    <span aria-hidden="true">🗑</span>
                    Supprimer
                </button>

            </form>

            {# Retour #}
            <a href="{{ path('admin_category_index') }}"
               class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg
                      border border-stone-300 bg-white text-stone-700 text-sm font-medium
                      hover:bg-stone-100 transition
                      focus:outline-none focus:ring-2 focus:ring-stone-400">
                <span aria-hidden="true">←</span>
                Retour à la liste
            </a>

        </div>

    </div>

    {#  FORMULAIRE  #}
    {{ include('admin/category/_form.html.twig') }}

</div>
{% endblock %}